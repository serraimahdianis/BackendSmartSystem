# MongoDB connection string
mongo_uri=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-attendance?appName=Cluster0

# JWT secret (generate a strong random key: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Server port
PORT=3000

# Admin credentials (for admin login endpoint only)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-this-admin-password

# SMTP for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Anti-fraud thresholds (milliseconds)
FRAUD_DUPLICATE_INTERVAL_MS=30000
FRAUD_VELOCITY_WINDOW_MS=5000
FRAUD_VELOCITY_THRESHOLD=3
FRAUD_SUSPICIOUS_SCORE_LIMIT=50
